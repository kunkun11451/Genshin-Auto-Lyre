{
  "name": "genshin-auto-lyre",
  "version": "1.0.0",
  "description": "Genshin Auto Lyre - 原神自动弹琴工具",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-builder --win"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "lucide-react": "^1.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tone": "^15.1.22",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.tanqin.genshinautolyre",
    "productName": "Genshin Auto Lyre",
    "win": {
      "target": ["portable"],
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.exe"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ]
  }
}
